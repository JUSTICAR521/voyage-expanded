{
  "manifest_version": 3,
  "name": "Voyage Expanded",
  "short_name": "Expanded",
  "version": "0.1.0",
  "version_name": "0.1.0 - Preview",
  "description": "Inventory organization for Voyage, with containers, equipment controls, and location storage.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "background": {
    "service_worker": "inventory-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://voyage.io/*",
        "https://*.voyage.io/*"
      ],
      "js": [
        "inventory-core-main.js",
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://voyage.io/*",
        "https://*.voyage.io/*"
      ],
      "js": [
        "expanded-core.js",
        "expanded-settings.js",
        "inventory-core.js",
        "item-details.js",
        "carried-tree.js",
        "inventory-operations.js",
        "inventory-draft.js",
        "inventory-lock.js",
        "inventory-panel.js",
        "voyage-adapter.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
