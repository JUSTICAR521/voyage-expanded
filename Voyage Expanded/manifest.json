{
  "manifest_version": 3,
  "name": "Voyage Expanded",
  "short_name": "Expanded",
  "version": "0.1.1",
  "version_name": "0.1.1 - Journal Development",
  "description": "Inventory organization and a permanent campaign journal for Voyage, with full turn history, personal entries, and clock editing.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "background": {
    "service_worker": "inventory-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://voyage.io/*",
        "https://*.voyage.io/*"
      ],
      "js": [
        "inventory-core-main.js",
        "journal-core-main.js",
        "bridge.js",
        "time-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://voyage.io/*",
        "https://*.voyage.io/*"
      ],
      "js": [
        "expanded-core.js",
        "expanded-settings.js",
        "inventory-core.js",
        "item-details.js",
        "carried-tree.js",
        "inventory-operations.js",
        "inventory-draft.js",
        "inventory-lock.js",
        "inventory-panel.js",
        "voyage-adapter.js",
        "time-ui.js",
        "time-panel.js",
        "journal-core.js",
        "journal-panel.js",
        "time-adapter.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
